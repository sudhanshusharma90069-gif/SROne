generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("free")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Deal {
  id             String   @id @default(cuid())
  store          String
  title          String
  description    String
  link           String   @unique
  category       String
  discount       String
  ai_summary     String
  originalPrice  Int
  discountedPrice Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
